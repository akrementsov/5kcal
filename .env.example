BOT_TOKEN=your_telegram_bot_token

# ── LLM ───────────────────────────────────────────────────────────────────────
# Провайдер: openai (по умолчанию) или gemini
# Модель и лимиты задаются в src/core/llm/{openai,gemini}/config.yaml
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
# Если LLM_PROVIDER=gemini
#GEMINI_API_KEY=your_gemini_key

# ── База данных ───────────────────────────────────────────────────────────────
# В Docker — DATABASE_URL подставляется автоматически из POSTGRES_*
# Локально (make run-local) — используется эта строка:
DATABASE_URL=postgresql://fivekcal:your_postgres_password@localhost:5432/fivekcal

POSTGRES_DB=fivekcal
POSTGRES_USER=fivekcal
POSTGRES_PASSWORD=your_postgres_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password
REDIS_TTL=604800
# Только для локального запуска Redis через `make redis-start`.
# В Docker игнорируются: docker-compose хардкодит bind/logfile/conf сам.
REDIS_BIND=127.0.0.1
REDIS_LOGFILE=logs/redis.log
REDIS_CONF=config/redis/redis.conf

TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Telegram user IDs администраторов (через запятую)
ADMIN_IDS=

# Алерты в Telegram (опционально)
# Используются и логгером бота (WARNING+), и Alertmanager (алерты Prometheus)
#ALERT_BOT_TOKEN=your_alert_bot_token
#ALERT_CHAT_ID=your_chat_id

# Порт Alertmanager на хосте (127.0.0.1)
#ALERTMANAGER_HOST_PORT=9093

# Robokassa — оплата подписки
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD1=your_password1
ROBOKASSA_PASSWORD2=your_password2
#ROBOKASSA_PASSWORD1_TEST=your_test_password1
#ROBOKASSA_PASSWORD2_TEST=your_test_password2

# ── Штрихкоды (опциональные платные базы) ─────────────────────────────────────
# FatSecret — запасная база штрихкодов
#FATSECRET_KEY=your_client_id
#FATSECRET_SECRET=your_client_secret
# Dietagram — платная база (русские продукты)
#DIETAGRAM_API_KEY=your_dietagram_key
# BarcodeLookup — платная база (международные продукты)
#BARCODE_LOOKUP_API_KEY=your_barcode_lookup_key

# ── Mini App «Статистика» ──────────────────────────────────────────────────────
# Mini App «Статистика» (webview). Пусто — кнопка в меню скрыта.
WEBAPP_URL=

# ── Тонкая настройка (дефолты в коде, менять необязательно) ──────────────────
# Состояния диалога (src/core/user_state/config.py):
#REDIS_EDITING_TTL=300           REDIS_CLARIFICATION_TTL=300
#REDIS_ANALYZING_TTL=180         REDIS_BARCODE_RETAKE_TTL=60
#CLARIFICATION_TIMEOUT_SECONDS=60  EDITING_TIMEOUT_SECONDS=60
# Анализ (src/features/meals/config.py):
#MAX_DIALOG_ROUNDS=3
# Уведомления об истечении подписки (src/features/notifications/config.py):
#NOTIFY_CHECK_INTERVAL=3600  NOTIFY_LOCAL_HOUR=12  NOTIFY_DAYS_BEFORE=5,1  NOTIFY_MESSAGE_DELAY=0.1
# Прочее:
#LOG_FILE=logs/bot.log           # пустая строка = писать только в stdout
#METRICS_HOST=0.0.0.0            # интерфейс HTTP-сервера метрик (src/core/metrics/config.py)
#OPENAI_DISABLE_PROMPT_CACHE=    # любое значение = отключить prompt cache OpenAI

# ── Мониторинг — порты на хосте ───────────────────────────────────────────────
# Порты на хосте — переопределяйте если заняты:
# Порты совпадают с тем, куда смотрят SSH-туннели (см. ~/.ssh/config).
# Локально порты переопределены в docker-compose.override.yml (не коммитится).
METRICS_PORT=9090
PROMETHEUS_HOST_PORT=9091
PROMETHEUS_RETENTION=30d
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password
DOZZLE_HOST_PORT=8888
